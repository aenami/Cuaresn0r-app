# Copiar fuera del repositorio o a server/backups/.env.backup (ignorado).
# No reutilizar JWT_SECRET, PRINT_AGENT_KEY ni la contraseña de PostgreSQL.
BACKUP_DATABASE_URL=postgresql://usuario:clave@HOST_DIRECTO:5432/BASE?sslmode=verify-full
BACKUP_LABEL=produccion
BACKUP_KEY_ID=principal-2026
BACKUP_ENCRYPTION_KEY=GENERAR_32_BYTES_BASE64_CON_EL_COMANDO_KEYGEN
BACKUP_DIR=C:/RESPALDOS_PRIVADOS/POS
PG_BIN_DIR=C:/Program Files/PostgreSQL/17/bin

# Solo se admiten bases de prueba NUEVAS en un PostgreSQL local.
RESTORE_TEST_ADMIN_URL=postgresql://postgres:clave@127.0.0.1:5432/postgres

# Recuperación REAL opcional, en una base que la herramienta CREA y CONSERVA.
# No se usa en el respaldo diario ni en restore-test. Debe permitir CREATEDB.
# Puede ser local o una conexión DIRECTA remota con TLS. No cambia Render.
# Completar solo durante una recuperación explícita, nunca desde el frontend.
RESTORE_ADMIN_URL=

# Opcional: activar únicamente después de escoger y configurar el almacenamiento.
BACKUP_S3_BUCKET=BUCKET_PRIVADO
BACKUP_S3_PREFIX=pos/produccion
BACKUP_S3_ENDPOINT=https://ID_CUENTA.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=CLAVE_S3_DE_RESPALDO
BACKUP_S3_SECRET_ACCESS_KEY=SECRETO_S3_DE_RESPALDO
