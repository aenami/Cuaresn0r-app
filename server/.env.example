# Copiar a .env y ajustar con las credenciales reales de la base de datos.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos?schema=public"

# Secreto para firmar los JWT de sesion. Usar un valor largo y aleatorio distinto por entorno.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Credenciales del usuario ADMIN que crea `npx prisma db seed` la primera vez
# (solo si aun no existe un usuario con ese email). Opcional: si se omiten,
# el seed usa admin@pos.local / Admin123! por defecto.
SEED_ADMIN_EMAIL="admin@pos.local"
SEED_ADMIN_PASSWORD="Admin123!"

# Almacenamiento de imagenes de productos. Si se define, las imagenes se suben a
# Cloudinary (necesario en Render: su disco es efimero). Sin esta variable se
# guardan en el disco local server/uploads/ (dev). Formato del panel de Cloudinary:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL="cloudinary://123456789012345:abcdEFGH...@mi-cloud"

# Dominios permitidos por CORS, separados por coma (p. ej. el dominio de Vercel).
# Sin esta variable, CORS queda abierto (util en dev).
# CORS_ORIGIN="https://mi-app.vercel.app"

# Zona horaria del servidor. En Render debe fijarse en America/Bogota porque el
# recargo nocturno de nomina y las fechas @db.Date/@db.Time dependen de ella.
# TZ="America/Bogota"
